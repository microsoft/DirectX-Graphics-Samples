<?xml version="1.0" encoding="utf-8"?>
<!--
  This sample uses an experimental D3D12 build (hooked in via
  ExperimentalD3D12.props) for DXR2.  The DirectXTK12 nuget below is
  pulled in for its SpriteBatch + SpriteFont (on-screen overlay text;
  see CreateUIFont / RenderUI in D3D12RaytracingClusteredGeometry.cpp).
  When a real Agility SDK NuGet supporting DXR2 ships, also re-add
  Microsoft.Direct3D.D3D12 the way sibling samples do.
-->
<packages>
  <package id="directxtk12_desktop_2019" version="2024.10.29.1" targetFramework="native" />
</packages>
